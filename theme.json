				{
					"color": "#0A4A50",
					"name": "Teal Hover",
					"slug": "primary-accent"
				},
				{
					"color": "#DAFF8C",
					"name": "Lime",
					"slug": "primary-alt"
				},
				{
					"color": "#E6F4D7",
					"name": "Lime Wash",
					"slug": "primary-alt-accent"
