{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [
				"page",
				"digimia_pattern",
				"post"
			],
			"title": "Page (Full Width, No Title)"
		},
		{
			"name": "page-blank",
			"postTypes": [
				"page"
			],
			"title": "Page (Blank, No Header or Footer)"
		},
		{
			"name": "page-with-sidebar",
			"postTypes": [
				"post",
				"page"
			],
			"title": "Page (With Sidebar)"
		}
	],
	"settings": {
		"appearanceTools": true,
