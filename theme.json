	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "var:custom|button|radius"
				},
				"spacing": {
					"padding": {
						"bottom": "var:custom|button|padding-block",
						"left": "var:custom|button|padding-inline",
						"right": "var:custom|button|padding-inline",
						"top": "var:custom|button|padding-block"
					}
				},
				"typography": {
					"fontSize": "var:custom|button|font-size",
					"fontStyle": "normal",
					"fontWeight": "var:custom|button|font-weight",
					"lineHeight": "var:custom|button|line-height"
				},
				"variations": {
					"outline": {
						"border": {
							"width": "0"
						},
						"spacing": {
							"padding": {
								"bottom": "var:custom|button|padding-block",
								"left": "var:custom|button|padding-inline",
								"right": "var:custom|button|padding-inline",
								"top": "var:custom|button|padding-block"
							}
						}
					}
				}
			},
