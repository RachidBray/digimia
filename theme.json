					"color": "#0C1F24",
					"name": "Ink",
					"slug": "main"
				},
				{
					"color": "#4E5A5B",
					"name": "Ink Soft",
					"slug": "main-accent"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "base"
				},
				{
					"color": "#616A6B",
					"name": "Slate Grey",
					"slug": "secondary"
				},
				{
					"color": "#ECF3F1",
					"name": "Mist",
					"slug": "tertiary"
				},
				{
					"color": "#DFE8E5",
					"name": "Border Light",
					"slug": "border-light"
				},
				{
					"color": "#BCCBC6",
					"name": "Border Dark",
					"slug": "border-dark"
				}
			]
		},
		"custom": {
			"button": {
				"fontSize": "var(--wp--preset--font-size--lead)",
				"fontWeight": "500",
				"lineHeight": "1.5556",
				"paddingBlock": "0.875rem",
				"paddingInline": "1.75rem",
				"radius": "9999px"
			},
			"color": {
				"dark": {
					"primary": "#DAFF8C",
					"primary-accent": "#E6FFAE",
					"primary-alt": "#9FD8C8",
					"primary-alt-accent": "#1B3A2C",
					"main": "#EEF5F3",
					"main-accent": "#B5C6C3",
					"base": "#04191C",
					"secondary": "#8FA3A1",
					"tertiary": "#082A2E",
					"border-light": "#12363A",
					"border-dark": "#1F4B50"
				},
				"light": {
					"primary": "var:preset|color|primary",
					"primary-accent": "var:preset|color|primary-accent",
					"primary-alt": "var:preset|color|primary-alt",
					"primary-alt-accent": "var:preset|color|primary-alt-accent",
					"main": "var:preset|color|main",
					"main-accent": "var:preset|color|main-accent",
					"base": "var:preset|color|base",
					"secondary": "var:preset|color|secondary",
					"tertiary": "var:preset|color|tertiary",
					"border-light": "var:preset|color|border-light",
					"border-dark": "var:preset|color|border-dark"
				}
			},
			"fontWeight": {
				"black": 900,
				"bold": 700,
				"extra-bold": 800,
				"extra-light": 200,
				"light": 300,
				"medium": 500,
				"regular": 400,
				"semi-bold": 600,
				"thin": 100
			},
			"lineHeight": {
				"body": 1.6,
				"loose": 2,
				"none": 1,
				"relaxed": 1.75,
				"snug": 1.2,
				"tight": 1.1
			},
			"radius": {
				"base": "8px",
				"full": "9999px",
				"lg": "12px",
				"sm": "6px",
				"xl": "20px"
			},
			"semantic": {
				"border": "var:preset|color|border-light",
				"border-hover": "var:preset|color|border-dark",
				"brand": "var:preset|color|primary",
				"brand-button": "var:preset|color|primary-alt",
				"brand-button-text": "var:preset|color|main",
				"brand-hover": "var:preset|color|primary-accent",
				"brand-muted": "color-mix(in srgb, var(--wp--preset--color--primary) 10%, transparent)",
				"focus-ring": "var(--wp--preset--color--primary)",
				"input-bg": "var:custom|semantic|surface-1",
				"input-border": "var:custom|semantic|border",
				"input-placeholder": "var:custom|semantic|text-tertiary",
				"input-text": "var:custom|semantic|text-primary",
				"marker": "var:preset|color|primary-alt",
				"marker-text": "currentColor",
				"on-accent": "var:preset|color|main",
				"surface-0": "var:preset|color|base",
				"surface-1": "var:preset|color|tertiary",
				"surface-2": "var:preset|color|border-light",
				"surface-3": "var:preset|color|border-dark",
				"text-primary": "var:preset|color|main",
				"text-secondary": "var:preset|color|main-accent",
				"text-tertiary": "var:preset|color|secondary",
				"error": "#DC2626",
				"success": "#16A34A",
				"warning": "#D97706",
				"info": "#2563EB"
			},
			"transition": "150ms cubic-bezier(0.4, 0, 0.2, 1)"
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Small",
					"shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
					"slug": "small"
				},
				{
					"name": "Medium",
					"shadow": "0 1px 2px 0 rgb(0 0 0 / 0.04), 0 6px 16px -4px rgb(0 0 0 / 0.08)",
					"slug": "medium"
				},
				{
					"name": "Large",
					"shadow": "0 2px 4px -1px rgb(0 0 0 / 0.04), 0 12px 28px -8px rgb(0 0 0 / 0.12)",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"shadow": "0 4px 8px -2px rgb(0 0 0 / 0.05), 0 24px 48px -12px rgb(0 0 0 / 0.18)",
					"slug": "x-large"
				},
				{
					"name": "Glow",
					"shadow": "0 0 20px 2px rgba(110, 86, 207, 0.15)",
					"slug": "glow"
				},
				{
					"name": "Inner",
					"shadow": "inset 0 2px 4px 0 rgb(0 0 0 / 0.06)",
					"slug": "inner"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Small",
					"size": "clamp(0.5rem, 1.5vw, 0.75rem)",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "clamp(1rem, 3vw, 1.5rem)",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "clamp(1.5rem, 3vw, 2rem)",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "clamp(2.5rem, 6vw, 4rem)",
					"slug": "x-large"
				},
				{
					"name": "2xl",
					"size": "clamp(3.5rem, 8vw, 6rem)",
					"slug": "xx-large"
				},
				{
					"name": "3xl",
					"size": "clamp(5rem, 10vw, 8rem)",
					"slug": "xxx-large"
				},
				{
					"name": "4xl",
					"size": "clamp(6rem, 12vw, 10rem)",
					"slug": "xxxx-large"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
