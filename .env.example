# Digimia — local environment template
#
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# See docs/ai/security.md for the full policy.

# Settings for the visual regression check (`yarn test:visual`,
# tests/visual/run.mjs).

# Base URL of the local WordPress site.
# Use the scheme + host only, no trailing slash.
WP_API_URL=https://edd.local

# A test CUSTOMER account (not an admin) for the signed-in account pages.
VISUAL_TEST_USERNAME=
VISUAL_TEST_PASSWORD=
